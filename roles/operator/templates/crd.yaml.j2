---
kind: CustomResourceDefinition
apiVersion: apiextensions.k8s.io/v1
metadata:
  name: datavisualisations.squonk.it
  annotations:
    data-manager.informaticsmatters.com/application: 'yes'
    data-manager.informaticsmatters.com/application-namespaces: '{{ svo_namespaces }}'
    data-manager.informaticsmatters.com/application-url-location: viz.url
    data-manager.informaticsmatters.com/application-data-centre: 'yes'
spec:
  conversion:
    strategy: None
  group: squonk.it
  names:
    kind: DataVisualisation
    listKind: DataVisualisationList
    plural: datavisualisations
    singular: datavisualisation
  scope: Namespaced
  versions:
  - additionalPrinterColumns:
    - description: URL for accessing the visualisation instance.
      jsonPath: .status.viz.url
      name: URL
      type: string
    name: v1
    schema:
      openAPIV3Schema:
        type: object
        properties:
          spec:
            type: object
            properties:
              # All DataManager-injected material
              # will be namespaced by the property 'imDataManager'
              imDataManager:
                type: object
                required:
                - imageTag
                properties:
                  taskId:
                    type: string
                  imageTag:
                    type: string
                  ingressClass:
                    type: string
                  ingressDomain:
                    type: string
                  ingressTlsSecret:
                    type: string
                  ingressProxyBodySize:
                    type: string
                  resources:
                    type: object
                    properties:
                      limits:
                        type: object
                        properties:
                          cpu:
                            type: string
                          memory:
                            type: string
                          storage:
                            type: string
                      requests:
                        type: object
                        properties:
                          cpu:
                            type: string
                          memory:
                            type: string
                          storage:
                            type: string
                  serviceAccountName:
                    type: string
                  securityContext:
                    type: object
                    properties:
                      runAsUser:
                        type: integer
                      runAsGroup:
                        type: integer
                      fsGroup:
                        type: integer
                  project:
                    type: object
                    properties:
                      claimName:
                        type: string
                      id:
                        type: string
                  # Optional. The project database (see the operator's README,
                  # "Project database"). The database must already exist and
                  # adminUser must be a superuser. Defaults for 'port', 'ssl'
                  # and the 'limits' are applied by the operator.
                  dataCentre:
                    type: object
                    required:
                    - host
                    - database
                    - adminUser
                    - adminPassword
                    properties:
                      host:
                        type: string
                      port:
                        type: integer
                        minimum: 1
                      ssl:
                        type: boolean
                      database:
                        type: string
                      adminUser:
                        type: string
                      adminPassword:
                        type: string
                      limits:
                        type: object
                        properties:
                          statementTimeout:
                            description: Seconds
                            type: integer
                            minimum: 1
                          tempFileLimitMB:
                            type: integer
                            minimum: 0
                          connectionLimit:
                            type: integer
                            minimum: 1
                  labels:
                    type: array
                    items:
                      type: string
          status:
            type: object
            x-kubernetes-preserve-unknown-fields: true
    served: true
    storage: true
