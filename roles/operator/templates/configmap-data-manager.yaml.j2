---

# A Data-Manager-compliant ConfigMap.
# This is deployed to the DM namespace and provides configuration material.
# The configMap must have the same name as the application CRD,
# e.g. 'datavisualisations.squonk.it'.
#
# The 'data' section provides a 'dm-app.config' key
# with a value that's essentially a Python Configparser file using '='
# as key/value delimiter.
#
# It also provides a 'dm-app.template' key - a JSON string (loaded by the
# Data Manager with json.loads()) describing the user-definable application
# variables a client can select. It is hard-coded for now.
# It offers no CPU or memory options: the operator fixes the viz container's
# resource requests and limits (see squonk2-viz-components issue #468).
#
# Finally it provides a 'dm-app.template.mapping' key - a JSON string (also
# loaded with json.loads()) that tells the Data Manager where each template
# property's value goes in the constructed Custom Resource. Each value is a
# list of paths (always a list, even for a single destination), dotted and
# relative to 'spec.imDataManager', the property under which the Data Manager
# injects the instance specification.

kind: ConfigMap
apiVersion: v1
metadata:
  name: datavisualisations.squonk.it
  namespace: {{ svo_dm_namespace }}
data:
  dm-app.config: |
    [cost]
    # Charging configuration
    cost = {{ svo_cost_cost }}
    period = {{ svo_cost_period }}
    unit = PxGi
    pro rata = yes
    [idle]
    # Automatic termination of idle instances.
    # The Data Manager polls the instance's idle endpoint and terminates
    # instances that have been idle for longer than 'terminate_after'
    # (and instances that fail to answer for long enough).
    #
    # 'path' and 'port' are properties of the viz application image, which
    # serves '/idle' on the only port it listens on. The path deliberately
    # carries no instance prefix: the Data Manager polls through the
    # instance's Service, which bypasses the Ingress.
    #
    # 'service_name' is not set. The Data Manager defaults it to the instance
    # UUID, which is the name of the custom resource, and so also the name the
    # operator gives the Service.
    #
    # NOTE: only viz application versions 0.3.2-3 and later serve '/idle'.
    #       Earlier versions answer with a 404, which the Data Manager counts
    #       as a failed query and, after a while, terminates the instance for.
    #       Keep the version enum below free of earlier versions.
    path = /idle
    port = 5170
    terminate_after = {{ svo_idle_terminate_after }}
  dm-app.template: |
    {
      "title": "The VizOperator Template",
      "description": "User-definable application variables for the viz application operator",
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "title": "Viz application version",
          "description": "The choice of viz application version.",
          "type": "string",
          "enum": ["0.10.0"]
        }
      }
    }
  dm-app.template.mapping: |
    {
      "version": [
        "imageTag"
      ]
    }
